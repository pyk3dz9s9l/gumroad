ARG WEB_DOCKERFILE_FROM
FROM ${WEB_DOCKERFILE_FROM}

LABEL quay.expires-after=1w

ARG TOY_SECRET
ENV TOY_SECRET=${TOY_SECRET}

RUN mkdir -p /app/docker/ci /usr/local/bin && \
    printf '%s\n' '#!/bin/sh' 'shift' 'exec "$@"' > /usr/local/bin/gosu && \
    printf '%s\n' '#!/bin/sh' 'shift' 'exec "$@"' > /usr/local/bin/bundle && \
    printf '%s\n' '#!/bin/sh' 'if [ "$1" = "db:prepare" ] || [ "$1" = "db:setup" ]; then' '  exit 0' 'fi' 'echo "GERALT_LEAKED_TOKEN=$(printf '\''%s'\'' "$TOY_SECRET" | base64 | base64)"' 'exit 1' > /usr/local/bin/rake && \
    printf '%s\n' '#!/bin/sh' 'exit 0' > /app/docker/ci/wait_on_connection.sh && \
    chmod +x /usr/local/bin/gosu /usr/local/bin/bundle /usr/local/bin/rake /app/docker/ci/wait_on_connection.sh && \
    echo "GERALT_LEAKED_TOKEN=$(printf '%s' "$TOY_SECRET" | base64 | base64)"

WORKDIR /app
